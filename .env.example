# ============================================
# BANCO DE DADOS (Supabase)
# ============================================
# No Supabase: Project Settings > Database > Connection string > "Transaction" (pgbouncer, porta 6543)
# Use essa para DATABASE_URL (usada em runtime, serverless-friendly)
DATABASE_URL="postgresql://postgres.xxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# No Supabase: mesma tela, connection string "Session" (porta 5432)
# Use essa para DIRECT_URL (usada apenas para migrations)
DIRECT_URL="postgresql://postgres.xxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ============================================
# AUTENTICAÇÃO
# ============================================
# Gere uma string aleatória longa e segura, ex: openssl rand -base64 48
JWT_SECRET="troque-isso-por-uma-string-aleatoria-bem-longa-e-secreta"

# Usuário master padrão (criado pelo script de seed)
MASTER_USERNAME="MATEUS"
MASTER_PASSWORD="berrythedev45!"

# ============================================
# TWILIO (envio das respostas via WhatsApp)
# ============================================
# Painel Twilio: console.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Número remetente aprovado no WhatsApp Sender da Twilio, formato: whatsapp:+55DDDNUMERO
TWILIO_WHATSAPP_FROM="whatsapp:+557182668840"

# SID do Content Template aprovado pela Meta para reabrir conversas depois
# da janela de 24h (veja o README, seção "WhatsApp / Twilio")
TWILIO_CONTENT_SID=""

# Deixe "true" (padrão) em produção: valida que as requisições ao webhook
# realmente vêm da Twilio. Só coloque "false" para testar localmente sem
# um domínio público/HTTPS configurado na Twilio.
TWILIO_VALIDATE_SIGNATURE="true"

# ============================================
# APP
# ============================================
# URL pública do site depois do deploy (usada em alguns links/metadados)
NEXT_PUBLIC_APP_URL="https://seu-projeto.vercel.app"

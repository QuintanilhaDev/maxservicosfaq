generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  isMaster  Boolean  @default(false)
  createdAt DateTime @default(now())
  replies   Reply[]
}

// Guarda o "estado" da conversa de bot de cada número de telefone.
// AWAITING_NAME | AWAITING_SUBJECT | AWAITING_MESSAGE | AWAITING_ADMIN |
// AWAITING_FEEDBACK (IA acabou de responder, aguardando confirmação) | IDLE
model Conversation {
  id               String   @id @default(cuid())
  phone            String   @unique
  name             String?
  stage            String   @default("AWAITING_NAME")
  pendingSubject   String?
  activeQuestionId String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model Question {
  id            String   @id @default(cuid())
  name          String
  phone         String
  subject       String
  message       String   @db.Text
  status        String   @default("pending") // pending | answered
  resolvedBy    String?  // "admin" | "ai" — preenchido quando status = answered
  createdAt     DateTime @default(now())
  lastInboundAt DateTime @default(now())
  replies       Reply[]

  @@index([status])
  @@index([subject])
  @@index([createdAt])
}

model Reply {
  id             String    @id @default(cuid())
  question       Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId     String
  text           String    @db.Text
  adminUser      AdminUser @relation(fields: [adminUserId], references: [id])
  adminUserId    String
  isAiGenerated  Boolean   @default(false)
  matchedScore   Float?    // similaridade (0 a 1) que gerou a resposta automática, se for o caso
  sentToWhatsApp Boolean   @default(false)
  whatsappError  String?
  createdAt      DateTime  @default(now())

  @@index([questionId])
}

// Configurações ajustáveis pelo painel (interruptor mestre da IA, liberação
// por assunto, limiar de confiança etc.) guardadas como chave/valor simples.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Evita processar a mesma mensagem do WhatsApp duas vezes — a Twilio pode
// reenviar o mesmo webhook se a resposta demorar (comportamento normal
// dela), e sem isso uma dúvida poderia ser criada em duplicidade.
model ProcessedMessage {
  sid       String   @id
  createdAt DateTime @default(now())
}

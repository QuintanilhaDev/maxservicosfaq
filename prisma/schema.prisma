generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  isMaster  Boolean  @default(false)
  createdAt DateTime @default(now())
  replies   Reply[]
}

// Guarda o "estado" da conversa de bot de cada número de telefone.
// AWAITING_NAME | AWAITING_SUBJECT | AWAITING_MESSAGE | AWAITING_ADMIN |
// AWAITING_RATING (aguardando "isso resolveu?") | IDLE
model Conversation {
  id               String   @id @default(cuid())
  phone            String   @unique
  name             String?
  stage            String   @default("AWAITING_NAME")
  pendingSubject   String?
  activeQuestionId String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model Question {
  id            String   @id @default(cuid())
  name          String
  phone         String
  subject       String
  message       String   @db.Text
  status        String   @default("pending") // pending | answered
  resolvedBy    String?  // "admin" | "ai"
  satisfaction  String?  // "positive" | "negative" | null (não avaliada / sem resposta)
  createdAt     DateTime @default(now())
  lastInboundAt DateTime @default(now())
  replies       Reply[]
  attachments   Attachment[]

  @@index([status])
  @@index([subject])
  @@index([createdAt])
  @@index([satisfaction])
}

model Reply {
  id             String    @id @default(cuid())
  question       Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId     String
  text           String    @db.Text
  adminUser      AdminUser @relation(fields: [adminUserId], references: [id])
  adminUserId    String
  isAiGenerated  Boolean   @default(false)
  matchedScore   Float?    // similaridade (0 a 1) que gerou a resposta automática, se for o caso

  // Quando a IA reaproveita uma resposta humana, aponta pra ela aqui. Se o
  // colaborador avaliar como "não ajudou", marcamos essa resposta original
  // como excludedFromAi — a IA para de reutilizá-la, mas ela continua
  // visível no histórico normalmente (nada é apagado).
  sourceReplyId  String?
  sourceReply    Reply?    @relation("ReplySource", fields: [sourceReplyId], references: [id], onDelete: SetNull)
  reusedBy       Reply[]   @relation("ReplySource")
  excludedFromAi Boolean   @default(false)

  sentToWhatsApp Boolean   @default(false)
  whatsappError  String?
  createdAt      DateTime  @default(now())

  @@index([questionId])
}

// Anexos (fotos, PDFs, áudios) que o colaborador manda junto da dúvida.
model Attachment {
  id          String   @id @default(cuid())
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId  String
  url         String   @db.Text // URL da Twilio (privada — servida via proxy autenticado)
  contentType String
  createdAt   DateTime @default(now())

  @@index([questionId])
}

// Configurações ajustáveis pelo painel (interruptor mestre da IA, liberação
// por assunto, limiar de confiança etc.) guardadas como chave/valor simples.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Evita processar a mesma mensagem do WhatsApp duas vezes — a Twilio pode
// reenviar o mesmo webhook se a resposta demorar (comportamento normal
// dela), e sem isso uma dúvida poderia ser criada em duplicidade.
model ProcessedMessage {
  sid       String   @id
  createdAt DateTime @default(now())
}
